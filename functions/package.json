{
  "name": "hirehuub-functions",
  "version": "1.0.0",
  "description": "HireHuub ERP Backend Cloud Functions Engine",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "20"
  },
  "dependencies": {
    "@sparticuz/chromium": "^133.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.3.0",
    "googleapis": "^174.0.1",
    "nodemailer": "^9.1.0",
    "puppeteer-core": "^25.7.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/node": "^20.17.19",
    "@types/nodemailer": "^8.0.1",
    "typescript": "^5.7.3"
  },
  "private": true
}
